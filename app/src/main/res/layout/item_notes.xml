<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardBackgroundColor="#707070"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:orientation="vertical">

            <View
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:id="@+id/proritey"
                android:background="@drawable/redcolorshape"
                android:layout_gravity="right"
                android:layout_margin="10dp"/>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NotesAppMVVMkotlin"
                android:minLines="1"
                android:id="@+id/noteTitle"
                android:textSize="20dp"
                android:layout_marginHorizontal="5dp"
                android:textStyle="bold"
                android:textColor="@color/white"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ahdhhakdifnienidddddddddddddddddndnjadfuabfaudfakdfbiaudfbjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjjadfuadbfuajdfubfaudbfkadfuadfbaudfajdbfiaudbfuwdfuasdbfaudfa"
                android:minLines="1"
                android:id="@+id/notesubTitle"
                android:textSize="16dp"
                android:layout_marginHorizontal="5dp"
                android:textColor="@color/white"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 march 2026"
                android:minLines="1"
                android:id="@+id/notedate"
                android:textSize="20dp"
                android:textStyle="bold"

                android:layout_marginTop="10dp"
                android:layout_marginHorizontal="5dp"
                android:textColor="@color/white"/>






        </LinearLayout>



    </androidx.cardview.widget.CardView>


</LinearLayout>