<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/new_graph"
    app:startDestination="@id/home_Fragment">

    <fragment
        android:id="@+id/home_Fragment"
        android:name="com.example.noteapp.Fragment.Home_Fragment"
        android:label="Notes App"
        tools:layout="@layout/fragment_home_" >
        <action
            android:id="@+id/action_home_Fragment_to_createfragment"
            app:destination="@id/createfragment" />
        <action
            android:id="@+id/action_home_Fragment_to_edit_Fragment"
            app:destination="@id/edit_Fragment" />
    </fragment>
    <fragment
        android:id="@+id/createfragment"
        android:name="com.example.noteapp.Fragment.Createfragment"
        android:label="add new Notes"
        tools:layout="@layout/fragment_createfragment" >
        <action
            android:id="@+id/action_createfragment_to_edit_Fragment"
            app:destination="@id/edit_Fragment" />
        <action
            android:id="@+id/action_createfragment_to_home_Fragment2"
            app:destination="@id/home_Fragment" />
    </fragment>

    <fragment
        android:id="@+id/edit_Fragment"
        android:name="com.example.noteapp.Fragment.Edit_Fragment"
        android:label="edit Notes"
        tools:layout="@layout/fragment_edit_" >

        <action
            android:id="@+id/action_edit_Fragment_to_createfragment"
            app:destination="@id/createfragment" />

        <!-- Fix here: use Notes as argType -->
        <argument
            android:name="data"
            app:argType="com.example.noteapp.Model.Notes" />
        <action
            android:id="@+id/action_edit_Fragment_to_home_Fragment"
            app:destination="@id/home_Fragment" />

    </fragment>
</navigation>







